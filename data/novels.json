  {
    "id": "fanzuoyong",
    "title": "反作用定律",
    "subtitle": "越想逃离，越被命运推回彼此身边。",
    "authorId": "author-1",
    "authorName": "泡菜坊主",
    "category": "女频",
    "status": "连载中",
    "updatedAt": "2026-06-05",
    "featured": true,
    "cover": "assets/images/covers/fanzuoyong-cover.svg",
    "banner": "assets/images/banners/fanzuoyong-banner.svg",
    "tags": [
      "bg",
      "modern"
    ],
    "intro": "财经主持人与年轻区长在舆论漩涡里维持一段不能公开的关系。她擅长把情绪剪辑成新闻，他擅长把野心伪装成温柔。",
    "heroine": "许知眠：锋利、理性、事业心强，情感上却习惯后撤。",
    "hero": "周砚庭：外表清贵克制，内里极具掌控欲，习惯把一切风险算进棋局。",
    "chapters": [
      {
        "id": "chapter-1",
        "title": "第1章 镜头之外",
        "date": "2026-06-05",
        "file": "chapters/fanzuoyong/chapter-1.html",
        "access": "free",
        "summary": "镜头关闭后，她接到他的电话。",
        "content": [
          "直播灯熄灭的一瞬间，许知眠才终于松开握得发僵的手。",
          "手机在化妆台上震动，屏幕亮起的名字让整个房间都安静下来。",
          "周砚庭。",
          "她没有立刻接。镜子里的女人妆容精致，眼神却像刚从一场无声的战役里退下来。",
          "电话第三次响起时，她按下接听。那头的声音很低：‘今晚别回家。’"
        ]
      },
      {
        "id": "chapter-2",
        "title": "第2章 危机公关",
        "date": "2026-06-06",
        "file": "chapters/fanzuoyong/chapter-2.html",
        "access": "free",
        "summary": "一条热搜把两个人推到台前。",
        "content": [
          "热搜是在凌晨两点爆的。",
          "照片拍得模糊，却足够让所有人看清周砚庭替她挡住车门的动作。",
          "许知眠盯着屏幕，忽然笑了一下。‘你不是说没人拍到吗？’",
          "周砚庭站在窗边，声音平稳：‘拍到不代表不能处理。’",
          "‘你处理新闻，我处理你。’她把手机反扣在桌上。"
        ]
      },
      {
        "id": "chapter-3",
        "title": "第3章 未公开关系",
        "date": "2026-06-07",
        "file": "chapters/fanzuoyong/chapter-3.html",
        "access": "order",
        "summary": "后续章节可通过社交入口联系。"
      }
    ]
  },
  {
    "id": "huimeng",
    "title": "回梦诊所",
    "subtitle": "每个噩梦，都藏着一段被篡改的记忆。",
    "authorId": "author-2",
    "authorName": "金枝",
    "category": "女频",
    "status": "已完结",
    "updatedAt": "2026-06-02",
    "featured": false,
    "cover": "assets/images/covers/huimeng-cover.svg",
    "banner": "assets/images/banners/huimeng-banner.svg",
    "tags": [
      "bg",
      "modern",
      "suspense"
    ],
    "intro": "乡镇诊所医生与夜间主播共同调查连环梦魇事件。白天她救人，夜里她被迫在梦里杀人。",
    "heroine": "林栖：白天是安静的乡村教师，夜晚却用另一个身份直播。",
    "hero": "顾停云：诊所医生，温柔得近乎无害，却总知道她最害怕什么。",
    "chapters": [
      {
        "id": "chapter-1",
        "title": "第1章 梦里来客",
        "date": "2026-06-01",
        "file": "chapters/huimeng/chapter-1.html",
        "access": "free",
        "summary": "诊所来了一个不会醒的病人。",
        "content": [
          "清晨六点，回梦诊所门口停着一辆没有牌照的黑车。",
          "车里的人睡得很沉，手腕上却写着林栖的名字。",
          "顾停云把白大褂扣到最后一颗，抬头看她：‘你昨晚梦见他了吗？’",
          "林栖没有回答。她的掌心还留着梦里那把刀的触感。"
        ]
      },
      {
        "id": "chapter-2",
        "title": "第2章 失眠村",
        "date": "2026-06-02",
        "file": "chapters/huimeng/chapter-2.html",
        "access": "free",
        "summary": "村里开始集体失眠。",
        "content": [
          "从第二天起，村里没人再睡得着。",
          "每个人都说自己听见了同一段铃声，像从很深的井底传上来。",
          "林栖站在广播室门口，发现门锁被人从里面打开。",
          "顾停云说：‘有人想把梦放出来。’"
        ]
      },
      {
        "id": "chapter-3",
        "title": "第3章 井底铃声",
        "date": "2026-06-03",
        "file": "chapters/huimeng/chapter-3.html",
        "access": "order",
        "summary": "后续章节可通过社交入口联系。"
      }
    ]
  },
  {
    "id": "yuese",
    "title": "月色病人",
    "subtitle": "他是病例，也是唯一的证词。",
    "authorId": "author-3",
    "authorName": "弯月",
    "category": "耽美",
    "status": "连载中",
    "updatedAt": "2026-06-04",
    "featured": true,
    "cover": "assets/images/covers/yuese-cover.svg",
    "banner": "assets/images/banners/yuese-banner.svg",
    "tags": [
      "bl",
      "modern",
      "suspense"
    ],
    "intro": "心理医生收治了一位只在月光下说真话的病人。病例越写越厚，医生却发现自己的名字早已出现在对方的旧档案里。",
    "heroine": "受 / 记录者：理性克制的心理医生，习惯用专业距离保护自己。",
    "hero": "攻 / 病人：温和、脆弱、危险，像一枚被月光浸湿的陷阱。",
    "chapters": [
      {
        "id": "chapter-1",
        "title": "第1章 月光门诊",
        "date": "2026-06-04",
        "file": "chapters/yuese/chapter-1.html",
        "access": "free",
        "summary": "病人只在月光下开口。",
        "content": [
          "夜间门诊只留了一盏灯。",
          "病人坐在窗边，月光落在他的袖口上，他终于说了第一句话。",
          "‘医生，我们以前见过。’",
          "程越翻开病历，发现入院时间被人改过。"
        ]
      },
      {
        "id": "chapter-2",
        "title": "第2章 空白病历",
        "date": "2026-06-05",
        "file": "chapters/yuese/chapter-2.html",
        "access": "free",
        "summary": "档案里出现了不该存在的名字。",
        "content": [
          "病历的第三页是空白。",
          "程越用灯照过去，纸背却慢慢浮出一行浅色的字。",
          "那是他的签名。",
          "病人抬起眼，轻声问：‘你终于想起来了吗？’"
        ]
      },
      {
        "id": "chapter-3",
        "title": "第3章 旧档案",
        "date": "2026-06-06",
        "file": "chapters/yuese/chapter-3.html",
        "access": "order",
        "summary": "后续章节可通过社交入口联系。"
      }
    ]
