  "segments": [
    {
      "blocks": [
        {
          "ko": "그는 천천히 고개를 들었다.",
          "cn": "他慢慢抬起了头。"
        },
        {
          "ko": "창밖에는 비가 내리고 있었다.",
          "cn": "窗外正下着雨。"
        }
      ]
    },
    {
      "blocks": [
        {
          "ko": "그 순간, 그는 자신이 도망칠 수 없다는 것을 깨달았다.",
          "cn": "那一刻，他意识到自己已经无法逃走。"
        },
        {
          "ko": "문 너머에서 낮은 목소리가 들려왔다.",
          "cn": "门外传来了低沉的声音。"
        }
      ]
    }
  ]
